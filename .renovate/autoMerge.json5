{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate merges automerge PRs itself, only once every check has finished green. main has no required status
  // checks, so GitHub-native automerge merged as soon as the PR was mergeable: 50 of 95 bot PRs (2026-06 to 2026-10)
  // landed before flux-local finished, e.g. #4316.
  platformAutomerge: false,
  packageRules: [
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge Helm / Docker minor + patch (gated by flux-local CI)",
      matchDatasources: ["helm", "docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      // Only bumps machine.install.image in talos/patches; nodes move when talosctl upgrade is run by hand.
      description: "Auto-merge Talos minor + patch",
      matchDatasources: ["custom.talos-factory"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "Auto-merge Grafana dashboard revisions",
      matchDatasources: ["custom.grafana-dashboards"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Disable auto-merge for stateful game-servers apps (manual review required)",
      matchFileNames: ["kubernetes/apps/base/game-servers/**"],
      automerge: false,
    },
  ],
}
