{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate merges automerge PRs itself, only once every check has finished green. main has no required status
  // checks, so GitHub-native automerge merged as soon as the PR was mergeable: 50 of 95 bot PRs (2026-06 to 2026-10)
  // landed before flux-local finished, e.g. #4316.
  platformAutomerge: false,
  packageRules: [
    {
      // Covers every datasource (helm, docker, npm, github-releases, talos factory, terraform, pre-commit...); majors
      // stay manual. Talos only bumps machine.install.image in talos/patches; nodes move when talosctl upgrade is run by hand.
      // rebaseWhen: automerge otherwise turns "auto" into behind-base-branch, so every merge to main sent the other
      // green PRs back for a rebase and a fresh CI run, and the hourly run merged at most one of them
      // (#4397-#4400 sat green for hours on 2026-10-20). main does not require branches to be up to date, so a green
      // PR can merge as-is; Renovate still rebases on conflicts.
      description: "Auto-merge minor + patch from every datasource once CI is green",
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      rebaseWhen: "conflicted",
    },
    {
      // Branch automerge fast-forwards main (git merge --ff-only), so these branches must stay rebased.
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: true,
      rebaseWhen: "auto",
    },
    {
      description: "Auto-merge Grafana dashboard revisions",
      matchDatasources: ["custom.grafana-dashboards"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      rebaseWhen: "auto",
    },
    {
      description: "Keep Renovate preset bumps manual (they change this automerge policy)",
      matchManagers: ["renovate-config"],
      automerge: false,
    },
    {
      description: "Disable auto-merge for stateful game-servers apps (manual review required)",
      matchFileNames: ["kubernetes/apps/base/game-servers/**"],
      automerge: false,
    },
  ],
}
