{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    // apps/ presets are opt-in since 6.0.0 and need their own tag (nested presets do not inherit the parent pin)
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    "security:openssf-scorecard",
    ":automergeDigest",
    ":semanticCommits",
    ":timezone(Australia/Melbourne)",
    "github>xunholy/k8s-gitops//.renovate/autoMerge.json5",
    "github>xunholy/k8s-gitops//.renovate/groups.json5",
    "github>xunholy/k8s-gitops//.renovate/labels.json5",
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Rate-limit how many update PRs exist at once. On 2026-09-15, 36 bumps landed in
  // ~65 minutes; the resulting pod churn and image pulls saturated the system disk
  // that etcd shares (WAL fsync p99 3ms -> 80-500ms), the apiserver timed out, and
  // eight operators lost leader election and restarted. Fewer PRs in flight means the
  // rollouts spread across hourly Renovate runs instead of arriving as one wave.
  prConcurrentLimit: 5,
  prHourlyLimit: 3,
  packageRules: [
    {
      description: "Hold patch/minor updates for 3 days to squash chain bumps into a single PR",
      matchUpdateTypes: ["patch", "minor"],
      minimumReleaseAge: "3 days",
      // Default is timestamp-required, which marks releases with no timestamp as pending forever.
      // quay.io returns no release timestamps, so cilium and cert-manager never left "pending" (no updates since 2026-05-21).
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // Minor bumps of these carry breaking changes that need sequencing (external-dns 1.22 drops the alpha
      // annotation prefix with no fallback; cilium 1.20 removes v2alpha1 CiliumLoadBalancerIPPool and must move in
      // lockstep with talos/integrations/cilium; rook-ceph 1.20 splits out ceph-csi-drivers). Patch stays automerged.
      description: "Never automerge minor updates of cluster-critical charts",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["/cilium/", "/external-dns/", "/rook-ceph/", "/cert-manager/", "quay.io/ceph/ceph"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      // AzerothCore targets MySQL 8.x LTS. MySQL's Innovation track ran 9.0-9.7 then jumped to calendar
      // versioning (26.7 = 2026), each release short-lived (~3 months support). Constrain the image to the
      // 8.4 LTS line so Renovate stops proposing Innovation/calendar releases (this rejects #4179, 9.7 -> 26.7).
      // The live datadir is still on 9.x; the move to 8.4 is a dump-and-reload migration, not an in-place bump,
      // so no downgrade PR is created (Renovate does not downgrade) until that migration changes the tag by hand.
      description: "Pin mysql image to the 8.4 LTS line (no Innovation/calendar releases)",
      matchDatasources: ["docker"],
      matchPackageNames: ["mysql", "docker.io/library/mysql"],
      allowedVersions: "/^8\\.4\\./",
    },
  ],
  "pre-commit": {
    enabled: true,
  },
  ignorePaths: [
    "**/*.enc.*",
    "**/resources/**",
    // Rendered from the chart pinned in talos/integrations/cilium/kustomization.yaml; regenerate it, never bump images in place
    "talos/integrations/cilium/cilium.yaml",
  ],
}
